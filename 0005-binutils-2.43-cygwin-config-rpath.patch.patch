From: =?UTF-8?q?Radek=20Barto=C5=88?= <radek.barton@microsoft.com>
Date: Tue, 3 Dec 2024 14:33:59 +0100
Subject: [PATCH 05/18] binutils-2.43-cygwin-config-rpath.patch

---
 config.rpath | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/config.rpath b/config.rpath
index 4dea75957c2..8bd08348a9a 100755
--- a/config.rpath
+++ b/config.rpath
@@ -438,7 +438,14 @@ case "$host_os" in
   bsdi4*)
     ;;
   cygwin* | mingw* | pw32*)
-    shrext=.dll
+    case "$TOOLCHAIN_TARGET" in
+      i686-w64-mingw32 | x86_64-w64-mingw32)
+	shrext=.dll.a
+	;;
+      *)
+	shrext=.dll
+	;;
+    esac
     ;;
   darwin* | rhapsody*)
     shrext=.dylib
