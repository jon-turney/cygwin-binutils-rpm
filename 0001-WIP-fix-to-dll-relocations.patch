From 5725657e2b698935ba792d2d2a0a817eb8eb6db2 Mon Sep 17 00:00:00 2001
From: Zac Walker <zac.walker@linaro.org>
Date: Wed, 16 Aug 2023 15:19:24 +0200
Subject: [PATCH 01/18] WIP fix to dll relocations

---
 gas/config/te-pep.h | 9 ++++++++-
 ld/configure.tgt    | 2 +-
 ld/emultempl/pep.em | 6 ++++--
 3 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/gas/config/te-pep.h b/gas/config/te-pep.h
index ed5c0ac7f54..a72675cac31 100644
--- a/gas/config/te-pep.h
+++ b/gas/config/te-pep.h
@@ -18,7 +18,14 @@
    02110-1301, USA.  */
 
 #define TE_PEP
-#define COFF_WITH_pex64
+
+#ifdef TARGET_IS_aarch64pe
+  #define COFF_WITH_peAArch64
+#elif defined TARGET_IS_arm64pe
+  #define COFF_WITH_peAArch64
+#elif defined (TARGET_IS_i386pep)
+  #define COFF_WITH_pex64
+#endif
 
 #define TE_PE
 #define LEX_AT (LEX_BEGIN_NAME | LEX_NAME) /* Can have @'s inside labels.  */
diff --git a/ld/configure.tgt b/ld/configure.tgt
index ea01ccf9a1b..0209b34f0fc 100644
--- a/ld/configure.tgt
+++ b/ld/configure.tgt
@@ -129,7 +129,7 @@ aarch64-*-nto*)		targ_emul=aarch64nto
 			;;
 aarch64-*-pe* | aarch64-*-mingw*)
 			targ_emul=aarch64pe
-			targ_extra_emuls="arm64pe"
+			targ_extra_emuls=arm64pe
 			targ_extra_ofiles="deffilep.o pep-dll-aarch64.o pe-dll.o pdb.o"
 			;;
 alpha*-*-freebsd* | alpha*-*-kfreebsd*-gnu)
diff --git a/ld/emultempl/pep.em b/ld/emultempl/pep.em
index 60a833947bd..2ed4a22be63 100644
--- a/ld/emultempl/pep.em
+++ b/ld/emultempl/pep.em
@@ -1183,6 +1183,8 @@ read_addend (arelent *rel, asection *s)
 	    addend = bfd_get_16 (s->owner, buf);
 	}
       break;
+    case 12:
+    case 21:
     case 26:
     case 32:
       ok = bfd_get_section_contents (s->owner, s, buf, rel->address, 4);
@@ -1201,8 +1203,8 @@ read_addend (arelent *rel, asection *s)
       break;
     }
   if (!ok)
-    einfo (_("%P: %H: cannot get section contents - auto-import exception\n"),
-	   s->owner, s, rel->address);
+    einfo (_("%P: %C: cannot get section contents - auto-import exception (bit size %d)\n"),
+	   s->owner, s, rel->address, rel->howto->bitsize);
   return addend;
 }
 
-- 
2.51.0

